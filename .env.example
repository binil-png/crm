# Copy this file to .env and fill in your Google Cloud values.
# Enable Google Sheets API and Google Calendar API on the same project.

# OAuth 2.0 Client ID (Web application) — required for Google sign-in
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Browser API key — used to initialize the Google API client
VITE_GOOGLE_API_KEY=your-api-key

# Spreadsheet ID from the sheet URL:
# https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
VITE_GOOGLE_SPREADSHEET_ID=your-spreadsheet-id

# Calendar that receives sales calls and training sessions.
# Use "primary" for the signed-in user's main calendar, or a calendar ID email.
VITE_GOOGLE_CALENDAR_ID=primary
