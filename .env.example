# Copy this file to .env and fill in your Google Cloud values.
# Enable Google Sheets API and Google Calendar API on the same project.

# OAuth 2.0 Client ID (Web application) — required for Google sign-in
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Browser API key — used to initialize the Google API client
VITE_GOOGLE_API_KEY=your-api-key

# Spreadsheet ID from the sheet URL:
# https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
VITE_GOOGLE_SPREADSHEET_ID=your-spreadsheet-id

# Calendar that receives sales calls and training sessions.
# Use "primary" for the signed-in user's main calendar, or a calendar ID email.
VITE_GOOGLE_CALENDAR_ID=primary

# --- Web push (works after the CRM tab is closed) ---
# Service: OneSignal (uses FCM/APNs under the hood; no custom server required for delivery).
# 1. Create a free app at https://onesignal.com
# 2. Add a Web platform. Site URL: http://localhost:5173 (and your production origin).
# 3. Copy the App ID into VITE_ONESIGNAL_APP_ID.
# 4. Copy the REST API Key into ONESIGNAL_REST_API_KEY (Settings > Keys & IDs).
#    Never prefix the REST key with VITE_ — that would expose it in the browser bundle.
VITE_ONESIGNAL_APP_ID=your-onesignal-app-id
ONESIGNAL_APP_ID=your-onesignal-app-id
ONESIGNAL_REST_API_KEY=your-onesignal-rest-api-key

# Optional. The CRM posts scheduled reminders here.
# Leave blank to use /api/push during `npm run dev` / `npm run preview`.
# In production, point this at a deployed function that uses api/send-push.js.
VITE_PUSH_API_URL=
